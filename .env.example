# 在 NAS 上用 `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 生成。
ARCHIVE_MASTER_KEY=replace-with-a-generated-fernet-key
ARCHIVE_PATH=./archive-data
APP_PORT=8099
PUID=1000
PGID=1000
TZ=Asia/Shanghai

